#!/bin/sh
# ./dev: the codebase CLI for agents working on the AI Engineer database contract (scripts/dev/dev_cli.py).
# Standard-library Python, so it runs before `pnpm install`. PowerShell: .\dev (dev.ps1).
root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
for py in python3 python py; do
  if command -v "$py" >/dev/null 2>&1 \
    && "$py" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 11) else 1)' >/dev/null 2>&1; then
    exec "$py" -X utf8 "$root/scripts/dev/dev_cli.py" "$@"
  fi
done
echo "dev: no Python 3.11+ on PATH; install Python 3.12" >&2
exit 3
