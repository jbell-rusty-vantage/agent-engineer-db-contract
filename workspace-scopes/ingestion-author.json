{
  "format": "ai-engineer-schema-scope/1",
  "id": "ingestion-author",
  "description": "Write-side authoring: everything an agent needs to compose knowledge-ingestion-intent.v1 proposals (identities with validated attributes, relationships, two-clock facts, evidence, staging, the receipt ledger) without the read-only api views.",
  "include": {
    "domains": [
      "identity",
      "relationships",
      "temporal-facts",
      "evidence",
      "staging",
      "orchestration-ledger"
    ],
    "relations": [
      "knowledge_service.operation",
      "content.document_type",
      "content.unit_assertion_mapping",
      "content.document_node"
    ],
    "functions": [
      "temporal.*",
      "catalog.*",
      "evidence.*",
      "staging.*",
      "verification.*",
      "util.current_tenant_id",
      "api.resolve_entity",
      "api.entity_at",
      "api.what_changed",
      "api.fact_locators",
      "api.price_history"
    ]
  },
  "exclude": {
    "relations": [
      "public.*",
      "evaluation.*",
      "observability.*",
      "evidence.verification_*",
      "orchestration.verification_*",
      "orchestration.mission*",
      "orchestration.work_item*",
      "orchestration.agent_session"
    ],
    "functions": [
      "catalog.import_research_starter_catalog"
    ]
  },
  "closure": {
    "fk_targets": "stub",
    "vocabularies": "full",
    "functions_touching_included": "summary"
  },
  "tasks": [
    "resolve-or-create-entity",
    "find-entity-by-identifier",
    "record-price-change",
    "record-availability-change",
    "assert-relationship",
    "supersede-stale-fact",
    "admit-support-for-claim",
    "stage-uncertain-candidate",
    "check-knowledge-head",
    "find-stale-facts",
    "compose-ingestion-intent",
    "verify-ingestion-result"
  ],
  "queries": [
    "entity.*",
    "facts.*",
    "events.*",
    "relationships.*",
    "vocab.*",
    "evidence.*",
    "staging.*",
    "receipts.*",
    "knowledge.head"
  ],
  "operations": []
}
