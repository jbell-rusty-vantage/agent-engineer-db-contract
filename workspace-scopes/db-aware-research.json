{
  "format": "ai-engineer-schema-scope/1",
  "id": "db-aware-research",
  "description": "Read-side exploration for research planning and ingestion authoring: identities, relationships, two-clock facts, evidence, staging, and the api surface (L1 views, L2 time, L3 search).",
  "include": {
    "domains": [
      "identity",
      "relationships",
      "temporal-facts",
      "evidence",
      "staging",
      "api-surface",
      "guidance",
      "verified-knowledge",
      "source-intelligence"
    ],
    "relations": [
      "orchestration.operation_intent",
      "orchestration.operation_receipt",
      "orchestration.artifact",
      "orchestration.artifact_type",
      "orchestration.intent_type",
      "knowledge_service.operation",
      "content.document",
      "content.document_node",
      "content.unit_kind"
    ],
    "functions": [
      "temporal.*",
      "api.*",
      "util.current_tenant_id"
    ]
  },
  "exclude": {
    "relations": [
      "public.*",
      "evaluation.*",
      "observability.*",
      "evidence.verification_*",
      "orchestration.verification_*"
    ],
    "functions": [
      "api.product_*",
      "api.submit_intent"
    ]
  },
  "closure": {
    "fk_targets": "stub",
    "vocabularies": "full",
    "functions_touching_included": "summary"
  },
  "tasks": [
    "what-do-we-know-about-entity",
    "resolve-or-create-entity",
    "find-entity-by-identifier",
    "record-price-change",
    "record-availability-change",
    "assert-relationship",
    "supersede-stale-fact",
    "admit-support-for-claim",
    "stage-uncertain-candidate",
    "what-changed-since-head",
    "what-changed-since",
    "check-knowledge-head",
    "build-evidence-packet",
    "run-hybrid-search",
    "find-stale-facts",
    "compose-ingestion-intent",
    "verify-ingestion-result",
    "compare-models",
    "price-with-locator",
    "what-is-verified-about-subject",
    "read-claim-with-evidence",
    "why-claim-disputed-or-restated",
    "how-trusted-is-source",
    "what-is-due",
    "what-a-release-affects"
  ],
  "queries": [
    "entity.*",
    "facts.*",
    "events.*",
    "relationships.*",
    "vocab.*",
    "evidence.*",
    "staging.*",
    "receipts.*",
    "knowledge.head",
    "artifacts.*",
    "retrieval.*",
    "catalog.*",
    "guidance.items",
    "content.*",
    "acquisition.attention_policies",
    "acquisition.attention_due",
    "ours.releases_needing_review",
    "ours.modules_affected_by_release"
  ],
  "operations": []
}
