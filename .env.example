# Database variables read by this repository (names only). Copy to .env (git-ignored) and fill in.
# Registry: config/env.registry.yaml. Values: BellLabs/.secrets/aieng-db.env.

# Schema-owner DSN of the AI Engineer Supabase project (session pooler, port 5432). Installers / schema-workspace.
AIENG_DB_ADMIN_DSN=
# Loopback DSN of a disposable local Supabase stack (types:generate:native needs 127.0.0.1:54322/postgres).
AIENG_DB_LOCAL_DSN=
# Supabase project ref (declared; not yet read by a script here).
AIENG_DB_PROJECT_REF=
